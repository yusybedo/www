    }
    
    match /projects/{project} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /blog/{article} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /contacts/{contact} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
